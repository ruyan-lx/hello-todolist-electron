{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2024",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "composite": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["vite/client"],
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strict": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "noEmit": true
    },
    "include": [
        "src/renderer/**/*.ts",
        "src/renderer/**/*.vue",
        "src/lib/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}
